# Supabase
SUPABASE_URL=
# Prefer the service role key for a private worker so RLS does not block queue processing.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback if your policies allow the worker to read/write these tables.
SUPABASE_ANON_KEY=

# Worker behavior
WORKER_POLL_INTERVAL_MS=60000
WORKER_BATCH_SIZE=10
WORKER_PUBLISH_RETRY_ATTEMPTS=3
WORKER_PUBLISH_RETRY_DELAY_MS=5000

# Meta Graph API
META_GRAPH_API_VERSION=v19.0
